    "todo-add": {
      "server": "organizer",
      "tool": "todo_add",
      "params": [
        "text",
        "due"
      ],
      "hint": "Adds a to-do to the user's list (optional due date: today, tomorrow, monday, 2026-11-25)",
      "example": "[[mcp:todo-add|Buy milk|tomorrow]]",
      "result": "both",
      "confirm": false
    },
    "todo-list": {
